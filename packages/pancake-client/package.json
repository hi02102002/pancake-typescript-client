{
  "name": "pancake-client",
  "version": "0.2.0",
  "description": "Unofficial, typed ESM client for the Pancake API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi02102002/pancake-typescript-client.git",
    "directory": "packages/pancake-client"
  },
  "homepage": "https://github.com/hi02102002/pancake-typescript-client#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "openapi/openapi.yaml",
    "openapi/webhook.yaml"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook/index.d.ts",
      "import": "./dist/webhook/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts src/webhook/index.ts --root src --outdir dist --target node --format esm --packages external && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "schema:generate": "bun run ../../scripts/generate-schema.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
